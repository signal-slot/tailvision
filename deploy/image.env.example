# Copy to deploy/image.env (git-ignored) and fill in. Read by deploy/build-image.sh.

# Hostname of the Pi; also its Tailscale name.
HOSTNAME=tailvision

# Login user created on first boot. Password may be empty if an SSH key is given.
USERNAME=pi
PASSWORD=

# Optional SSH public key for the user's authorized_keys. Leave empty for images
# you hand to others; shell access then comes through Tailscale SSH.
SSH_PUBKEY_FILE=

# Wi-Fi (optional: leave empty to configure it through the setup hotspot).
# The Zero W only does 2.4 GHz. Country is the ISO 3166-1 alpha-2 code.
WIFI_SSID=
WIFI_PSK=
WIFI_COUNTRY=JP

# Optional: a Tailscale auth key (https://login.tailscale.com/admin/settings/keys).
# If set, the Pi joins the tailnet on first boot with `tailscale up --ssh`.
# If empty, run `sudo tailscale up --ssh` once over LAN SSH after the first boot.
TAILSCALE_AUTHKEY=

# Optional per-unit password for the setup hotspot (8+ characters). Written to
# the boot partition as hotspot-password; print it on the unit's label.
HOTSPOT_PASSWORD=

# Optional, debugging only: set to 1 to also expose a USB Ethernet link to the
# device under test (10.42.1.0/24, NAT to Wi-Fi), so the unit can reach the
# target over the cable (SSH, ADB). Written as the marker file usb-ethernet on
# the boot partition; delete that file to turn it off again.
USB_ETHERNET=

# Timezone.
TIMEZONE=Asia/Tokyo
